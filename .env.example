DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
# Must match a redirect in the Discord developer portal (OAuth2 tab)
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
# Long random string, e.g. `openssl rand -hex 32` (the installer generates one)
SESSION_SECRET=random_session_secret
PORT=3000
DASHBOARD_URL=http://localhost:3000
# Reverse proxy in front of the dashboard (nginx, Caddy, Cloudflare)? Empty = automatic:
# trusted when DASHBOARD_URL is https. Set true/false to force it.
TRUST_PROXY=
NODE_ENV=production
LOG_LEVEL=info
DATABASE_CLIENT=sqlite
DATABASE_PATH=./data/rocketeerbot.db
# Only used by `node deploy-commands.js --clear-all`
DEV_GUILD_ID=

# PostgreSQL (set DATABASE_CLIENT=postgres and either DATABASE_URL or the PG* values)
# DATABASE_URL=postgres://rocketeerbot:password@127.0.0.1:5432/rocketeerbot
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=rocketeerbot
# PGUSER=rocketeerbot
# PGPASSWORD=password
# DATABASE_SSL=false              # true = TLS with certificate check, no-verify = TLS without it
# DATABASE_POOL_SIZE=10
