  <script>
  function copyId(el, id) {
    navigator.clipboard.writeText(id);
    const orig = el.textContent;
    el.textContent = 'Copied!';
    el.classList.add('copy-flash');
    setTimeout(() => { el.textContent = orig; el.classList.remove('copy-flash'); }, 1000);
  }
  </script>
