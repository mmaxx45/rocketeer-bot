<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>RocketeerBot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">
  <link href="/css/style.css" rel="stylesheet">
  <% if (typeof guild !== 'undefined' && guild && guild.icon) { %>
    <link rel="icon" type="image/png" href="<%= guild.icon %>?size=64">
  <% } %>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="bi bi-rocket-takeoff"></i> RocketeerBot
      </a>
      <% if (user) { %>
        <div class="d-flex align-items-center gap-3">
          <a href="/dashboard" class="btn btn-outline-light btn-sm">
            <i class="bi bi-grid-fill"></i> Dashboard
          </a>
          <div class="d-flex align-items-center gap-2">
            <% if (user.avatar) { %>
              <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=32"
                   class="rounded-circle user-avatar" width="32" height="32" alt="avatar">
            <% } %>
            <span class="text-light" style="font-size: 0.88rem; font-weight: 500;"><%= user.global_name || user.username %></span>
            <a href="/auth/logout" class="btn btn-outline-danger btn-sm">
              <i class="bi bi-box-arrow-right"></i>
            </a>
          </div>
        </div>
      <% } %>
    </div>
  </nav>
  <main class="container py-4">
