<%- header %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/dashboard">Servers</a></li>
    <li class="breadcrumb-item active"><%= guild.name %></li>
  </ol>
</nav>

<div class="guild-page-header">
  <div class="guild-title">
    <% if (guild.icon) { %>
      <img src="<%= guild.icon %>?size=80" class="guild-icon-sm" alt="icon">
    <% } %>
    <h2><%= guild.name %></h2>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a href="/dashboard/guild/<%= guild.id %>/warnings" class="btn btn-outline-warning btn-sm">
      <i class="bi bi-exclamation-triangle"></i> Warnings
    </a>
    <a href="/dashboard/guild/<%= guild.id %>/stats" class="btn btn-outline-info btn-sm">
      <i class="bi bi-bar-chart-line"></i> Stats
    </a>
  </div>
</div>

<div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3"></div>

<form id="settings-form" data-guild-id="<%= guild.id %>">
  <div class="guild-settings-layout">

    <!-- Sidebar Navigation -->
    <div class="settings-sidebar">
      <a class="sidebar-nav-item active" href="#section-roles" data-section="section-roles">
        <i class="bi bi-shield"></i> Roles
      </a>
      <a class="sidebar-nav-item" href="#section-channels" data-section="section-channels">
        <i class="bi bi-hash"></i> Channels
      </a>
      <a class="sidebar-nav-item" href="#section-crosspost" data-section="section-crosspost">
        <i class="bi bi-layers"></i> Crosspost Detection
      </a>
      <a class="sidebar-nav-item" href="#section-autokick" data-section="section-autokick">
        <i class="bi bi-door-open"></i> Auto-Kick
      </a>
      <a class="sidebar-nav-item" href="#section-warnings" data-section="section-warnings">
        <i class="bi bi-exclamation-octagon"></i> Warning System
      </a>
      <a class="sidebar-nav-item" href="#section-exempt" data-section="section-exempt">
        <i class="bi bi-slash-circle"></i> Exempt Channels
      </a>
      <a class="sidebar-nav-item" href="#section-imageonly" data-section="section-imageonly">
        <i class="bi bi-image"></i> Image-Only Channels
      </a>
      <a class="sidebar-nav-item" href="#section-modmail" data-section="section-modmail">
        <i class="bi bi-envelope"></i> Modmail
      </a>
      <a class="sidebar-nav-item" href="#section-fileblock" data-section="section-fileblock">
        <i class="bi bi-file-earmark-lock"></i> File Blocking
      </a>
      <a class="sidebar-nav-item" href="#section-filter" data-section="section-filter">
        <i class="bi bi-funnel"></i> Word Filter
      </a>
      <a class="sidebar-nav-item" href="#section-linkban" data-section="section-linkban">
        <i class="bi bi-link-45deg"></i> Link Ban List
      </a>
      <a class="sidebar-nav-item" href="#section-appeals" data-section="section-appeals">
        <i class="bi bi-person-check"></i> Ban Appeals
      </a>
      <a class="sidebar-nav-item" href="#section-warnreasons" data-section="section-warnreasons">
        <i class="bi bi-list-check"></i> Warning Reasons
      </a>
      <a class="sidebar-nav-item" href="#section-messages" data-section="section-messages">
        <i class="bi bi-chat-quote"></i> Custom Messages
      </a>
      <a class="sidebar-nav-item" href="#section-bot" data-section="section-bot">
        <i class="bi bi-robot"></i> Bot
      </a>
    </div>

    <!-- Settings Content -->
    <div class="settings-content">

      <!-- Roles Section -->
      <div class="settings-section" id="section-roles">
        <div class="section-header">
          <i class="bi bi-shield"></i>
          <h5>Roles</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label">Moderator Role</label>
                <span class="setting-hint">This role and all roles above it are exempt from crosspost detection.</span>
                <select name="moderator_role_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= settings.moderator_role_id === role.id ? 'selected' : '' %>>
                      <%= role.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label">Warn Role (Trial Mod)</label>
                <span class="setting-hint">Members with this role can issue warnings but cannot ban.</span>
                <select name="warn_role_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= settings.warn_role_id === role.id ? 'selected' : '' %>>
                      <%= role.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-hammer"></i> Ban Role</label>
                <span class="setting-hint">Members with this role can use /ban without needing the Ban Members permission.</span>
                <select name="ban_role_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= settings.ban_role_id === role.id ? 'selected' : '' %>>
                      <%= role.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-clipboard-data"></i> Mod Actions Role</label>
                <span class="setting-hint">Members with this role can view moderator action history via /modactions. Admins can always view.</span>
                <select name="modactions_role_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= settings.modactions_role_id === role.id ? 'selected' : '' %>>
                      <%= role.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-search"></i> Ban Reason Role</label>
                <span class="setting-hint">Members with this role can use /banreason to look up why a user was banned.</span>
                <select name="banreason_role_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= settings.banreason_role_id === role.id ? 'selected' : '' %>>
                      <%= role.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Channels Section -->
      <div class="settings-section" id="section-channels">
        <div class="section-header">
          <i class="bi bi-hash"></i>
          <h5>Log Channels</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-journal-text"></i> Warn Log Channel</label>
                <span class="setting-hint">Channel where warning details are posted. Set to "Disabled" to turn off.</span>
                <select name="warn_log_channel_id" class="form-select">
                  <option value="">-- Disabled --</option>
                  <% channels.forEach(ch => { %>
                    <option value="<%= ch.id %>" <%= settings.warn_log_channel_id === ch.id ? 'selected' : '' %>>
                      #<%= ch.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-hammer"></i> Ban Log Channel</label>
                <span class="setting-hint">Channel where bans triggered by the warning system are logged.</span>
                <select name="ban_log_channel_id" class="form-select">
                  <option value="">-- Disabled --</option>
                  <% channels.forEach(ch => { %>
                    <option value="<%= ch.id %>" <%= settings.ban_log_channel_id === ch.id ? 'selected' : '' %>>
                      #<%= ch.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Crosspost Detection Section -->
      <div class="settings-section" id="section-crosspost">
        <div class="section-header">
          <i class="bi bi-layers"></i>
          <h5>Crosspost Detection</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-sliders"></i> Similarity Threshold</label>
                <span class="setting-hint">How similar messages must be to trigger detection (1-100%).</span>
                <div class="d-flex align-items-center gap-3">
                  <input type="range" name="crosspost_threshold" class="form-range flex-grow-1"
                         min="1" max="100" value="<%= settings.crosspost_threshold %>"
                         oninput="this.nextElementSibling.textContent = this.value + '%'">
                  <span class="badge bg-primary fs-6" style="min-width: 52px; text-align: center;"><%= settings.crosspost_threshold %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-clock"></i> Detection Window</label>
                <span class="setting-hint">How quickly a similar message in another channel triggers detection.</span>
                <div class="input-group">
                  <input type="number" name="crosspost_detection_seconds" class="form-control"
                         min="5" max="300" value="<%= settings.crosspost_detection_seconds %>">
                  <span class="input-group-text">seconds</span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-arrow-repeat"></i> Repeat Offense Window</label>
                <span class="setting-hint">If a user crossposts again within this period, it escalates to a warning.</span>
                <div class="input-group">
                  <input type="number" name="crosspost_window_hours" class="form-control"
                         min="1" max="168" value="<%= settings.crosspost_window_hours %>">
                  <span class="input-group-text">hours</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Auto-Kick Section -->
      <div class="settings-section" id="section-autokick">
        <div class="section-header">
          <i class="bi bi-door-open"></i>
          <h5>Auto-Kick</h5>
        </div>
        <div class="section-body">
          <span class="setting-hint mb-3 d-block">Automatically kick users who repeatedly crosspost within a configurable time window.</span>
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-door-open"></i> Incident Count</label>
                <span class="setting-hint">Number of crosspost incidents within the kick window that triggers an automatic kick.</span>
                <div class="input-group">
                  <input type="number" name="crosspost_kick_count" class="form-control"
                         min="1" max="50" value="<%= settings.crosspost_kick_count %>">
                  <span class="input-group-text">incidents</span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-stopwatch"></i> Time Window</label>
                <span class="setting-hint">Time window in which crosspost incidents are counted for the auto-kick threshold.</span>
                <div class="input-group">
                  <input type="number" name="crosspost_kick_window_minutes" class="form-control"
                         min="1" max="10080" value="<%= settings.crosspost_kick_window_minutes %>">
                  <span class="input-group-text">minutes</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Warning System Section -->
      <div class="settings-section" id="section-warnings">
        <div class="section-header">
          <i class="bi bi-exclamation-octagon"></i>
          <h5>Warning System</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label">Warning Threshold</label>
                <span class="setting-hint">Number of warnings before moderators are prompted to ban.</span>
                <div class="input-group">
                  <input type="number" name="warning_threshold" class="form-control"
                         min="1" max="50" value="<%= settings.warning_threshold %>">
                  <span class="input-group-text">warnings</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Exempt Channels Section -->
      <div class="settings-section" id="section-exempt">
        <div class="section-header">
          <i class="bi bi-slash-circle"></i>
          <h5>Exempt Channels</h5>
        </div>
        <div class="section-body">
          <div class="setting-item">
            <span class="setting-hint">Messages in these channels are not checked for crossposts.</span>
            <div class="d-flex flex-wrap gap-2 mb-3" id="exempt-channels-list">
              <% exemptChannels.forEach(chId => { %>
                <% const ch = channels.find(c => c.id === chId); %>
                <span class="badge bg-secondary d-flex align-items-center gap-1 py-1 exempt-badge" data-channel-id="<%= chId %>">
                  #<%= ch ? ch.name : chId %>
                  <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.5rem; width: 0.5em; height: 0.5em;"
                          onclick="removeExemptChannel('<%= guild.id %>', '<%= chId %>', this)"></button>
                </span>
              <% }); %>
            </div>
            <div class="input-group">
              <select id="add-exempt-channel" class="form-select">
                <option value="">-- Select channel --</option>
                <% channels.forEach(ch => { %>
                  <% if (!exemptChannels.includes(ch.id)) { %>
                    <option value="<%= ch.id %>">#<%= ch.name %></option>
                  <% } %>
                <% }); %>
              </select>
              <button type="button" class="btn btn-outline-primary"
                      onclick="addExemptChannel('<%= guild.id %>')">
                <i class="bi bi-plus-lg"></i> Add
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Image-Only Channels Section -->
      <div class="settings-section" id="section-imageonly">
        <div class="section-header">
          <i class="bi bi-image"></i>
          <h5>Image-Only Channels</h5>
        </div>
        <div class="section-body">
          <div class="setting-item">
            <span class="setting-hint">Messages without image attachments will be automatically deleted from these channels.</span>
            <div class="d-flex flex-wrap gap-2 mb-3" id="image-only-channels-list">
              <% if (typeof imageOnlyChannels !== 'undefined' && imageOnlyChannels) { %>
                <% imageOnlyChannels.forEach(chId => { %>
                  <% const ch = channels.find(c => c.id === chId); %>
                  <span class="badge bg-secondary d-flex align-items-center gap-1 py-1 image-only-badge" data-channel-id="<%= chId %>">
                    #<%= ch ? ch.name : chId %>
                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.5rem; width: 0.5em; height: 0.5em;"
                            onclick="removeImageOnlyChannel('<%= guild.id %>', '<%= chId %>', this)"></button>
                  </span>
                <% }); %>
              <% } %>
            </div>
            <div class="input-group">
              <select id="add-image-only-channel" class="form-select">
                <option value="">-- Select channel --</option>
                <% channels.forEach(ch => { %>
                  <% if (typeof imageOnlyChannels === 'undefined' || !imageOnlyChannels || !imageOnlyChannels.includes(ch.id)) { %>
                    <option value="<%= ch.id %>">#<%= ch.name %></option>
                  <% } %>
                <% }); %>
              </select>
              <button type="button" class="btn btn-outline-primary"
                      onclick="addImageOnlyChannel('<%= guild.id %>')">
                <i class="bi bi-plus-lg"></i> Add
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Modmail Section -->
      <div class="settings-section" id="section-modmail">
        <div class="section-header">
          <i class="bi bi-envelope"></i>
          <h5>Modmail</h5>
        </div>
        <div class="section-body">
          <span class="setting-hint mb-3 d-block">Allow users to DM the bot to contact moderators privately.</span>
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-toggle-on"></i> Enable Modmail</label>
                <span class="setting-hint">When enabled, users can DM the bot to open a modmail thread.</span>
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" role="switch" id="modmail_enabled" name="modmail_enabled" value="on"
                         <%= settings.modmail_enabled ? 'checked' : '' %>>
                  <label class="form-check-label" for="modmail_enabled">Enabled</label>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-folder"></i> Modmail Category</label>
                <span class="setting-hint">Category where modmail thread channels will be created.</span>
                <select name="modmail_category_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.id %>" <%= settings.modmail_category_id === cat.id ? 'selected' : '' %>>
                      <%= cat.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- File Upload Blocking Section -->
      <div class="settings-section" id="section-fileblock">
        <div class="section-header">
          <i class="bi bi-file-earmark-lock"></i>
          <h5>File Upload Blocking</h5>
        </div>
        <div class="section-body">
          <span class="setting-hint mb-3 d-block">Block uploads of files with dangerous extensions. Exempt users (admins/mods) are not affected.</span>
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-toggle-on"></i> Enable File Blocking</label>
                <span class="setting-hint">When enabled, files with blocked extensions will be automatically deleted.</span>
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" role="switch" id="file_block_enabled"
                         name="file_block_enabled" value="1" <%= settings.file_block_enabled ? 'checked' : '' %>>
                  <label class="form-check-label" for="file_block_enabled">File blocking enabled</label>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-file-earmark-x"></i> Blocked Extensions</label>
                <span class="setting-hint">Comma-separated list of blocked file extensions (without dots). Leave blank to use defaults.</span>
                <textarea name="blocked_extensions" class="form-control" rows="3"
                          placeholder="exe, bat, cmd, msi, scr, pif, com, vbs, vbe, js, jse, wsf, wsh, ps1, psm1, psd1, reg, inf, hta, cpl, msp, mst, sct, ws, dll, sys, drv, ocx, jar, apk, deb, rpm, dmg, iso, img, lnk, url, desktop"><%= settings.blocked_extensions ? (() => { try { return JSON.parse(settings.blocked_extensions).join(', '); } catch { return ''; } })() : '' %></textarea>
                <a href="#" class="small mt-1 d-inline-block reset-default" data-target="blocked_extensions">Reset to default</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Word Filter Section -->
      <div class="settings-section" id="section-filter">
        <div class="section-header">
          <i class="bi bi-funnel"></i>
          <h5>Word Filter</h5>
        </div>
        <div class="section-body">
          <span class="setting-hint mb-3 d-block">Filter messages containing banned words. Hard-filtered words are instantly deleted, soft-filtered words trigger after a threshold, auto-delete words are silently removed.</span>
          <div class="row">
            <div class="col-md-4">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-toggle-on"></i> Enable Word Filter</label>
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" role="switch" id="filter_enabled"
                         name="filter_enabled" value="1" <%= settings.filter_enabled ? 'checked' : '' %>>
                  <label class="form-check-label" for="filter_enabled">Enabled</label>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="setting-item">
                <label class="setting-label">Soft Slur Threshold</label>
                <span class="setting-hint">Number of soft-filtered words within the window before action.</span>
                <input type="number" name="soft_slur_threshold" class="form-control" min="1" max="50"
                       value="<%= settings.soft_slur_threshold || 3 %>">
              </div>
            </div>
            <div class="col-md-4">
              <div class="setting-item">
                <label class="setting-label">Soft Slur Window</label>
                <span class="setting-hint">Time window in minutes for soft-filtered word tracking.</span>
                <div class="input-group">
                  <input type="number" name="soft_slur_window_minutes" class="form-control" min="1" max="1440"
                         value="<%= settings.soft_slur_window_minutes || 10 %>">
                  <span class="input-group-text">min</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Add Word -->
          <div class="setting-item mt-3">
            <label class="setting-label">Add Filtered Word</label>
            <div class="d-flex gap-2">
              <input type="text" id="filter-word-input" class="form-control" placeholder="Enter word..." style="max-width: 250px;">
              <select id="filter-word-tier" class="form-select" style="max-width: 150px;">
                <option value="hard">Hard</option>
                <option value="soft">Soft</option>
                <option value="auto_delete">Auto Delete</option>
              </select>
              <button type="button" class="btn btn-outline-primary" onclick="addFilterWord('<%= guild.id %>')">
                <i class="bi bi-plus-lg"></i> Add
              </button>
            </div>
          </div>

          <!-- Word List -->
          <div class="mt-3" id="filter-words-container">
            <div class="text-center py-3" id="filter-words-loading">
              <span class="loading-spinner"></span>
              <span class="ms-2" style="color: var(--text-muted); font-size: 0.88rem;">Loading filtered words...</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Link Ban List Section -->
      <div class="settings-section" id="section-linkban">
        <div class="section-header">
          <i class="bi bi-link-45deg"></i>
          <h5>Link Ban List</h5>
        </div>
        <div class="section-body">
          <div class="setting-item">
            <span class="setting-hint">Messages containing links to these domains will be automatically deleted.</span>
            <div class="d-flex flex-wrap gap-2 mb-3" id="banned-domains-list">
              <% if (typeof bannedDomains !== 'undefined' && bannedDomains) { %>
                <% bannedDomains.forEach(domain => { %>
                  <span class="badge bg-secondary d-flex align-items-center gap-1 py-1 domain-badge" data-domain="<%= domain %>">
                    <i class="bi bi-globe2" style="font-size: 0.7rem;"></i> <%= domain %>
                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.5rem; width: 0.5em; height: 0.5em;"
                            onclick="removeBannedDomain('<%= guild.id %>', '<%= domain %>', this)"></button>
                  </span>
                <% }); %>
              <% } %>
            </div>
            <div class="input-group">
              <input type="text" id="banned-domain-input" class="form-control" placeholder="example.com">
              <button type="button" class="btn btn-outline-primary"
                      onclick="addBannedDomain('<%= guild.id %>')">
                <i class="bi bi-plus-lg"></i> Add
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Ban Appeals Section -->
      <div class="settings-section" id="section-appeals">
        <div class="section-header">
          <i class="bi bi-person-check"></i>
          <h5>Ban Appeals</h5>
        </div>
        <div class="section-body">
          <span class="setting-hint mb-3 d-block">Allow banned users to submit appeals through the bot. When enabled, banned users can DM the bot to request an appeal, which creates a channel in the specified category for moderator review.</span>
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-toggle-on"></i> Enable Ban Appeals</label>
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" role="switch" id="appeal_enabled"
                         name="appeal_enabled" value="1" <%= settings.appeal_enabled ? 'checked' : '' %>>
                  <label class="form-check-label" for="appeal_enabled">Appeals enabled</label>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-folder"></i> Appeal Category</label>
                <span class="setting-hint">Category where appeal channels will be created.</span>
                <select name="appeal_category_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.id %>" <%= settings.appeal_category_id === cat.id ? 'selected' : '' %>>
                      <%= cat.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-link-45deg"></i> Server Invite Code</label>
                <span class="setting-hint">A permanent invite code so unbanned users can rejoin. Just the code, not the full URL (e.g. <code>abc123</code>).</span>
                <input type="text" name="appeal_invite_code" class="form-control" placeholder="abc123"
                       value="<%= settings.appeal_invite_code || '' %>" maxlength="32">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Warning Reasons Section -->
      <div class="settings-section" id="section-warnreasons">
        <div class="section-header">
          <i class="bi bi-list-check"></i>
          <h5>Warning Reasons</h5>
        </div>
        <div class="section-body">
          <div class="setting-item">
            <label class="setting-label">Custom Warning Reasons</label>
            <span class="setting-hint">Customize the autocomplete suggestions shown when moderators use /warn. One reason per line. Leave blank to use defaults.</span>
            <textarea name="custom_warn_reasons" class="form-control" rows="6"
                      placeholder="Spam or flooding&#10;Inappropriate language&#10;Harassment or bullying&#10;NSFW content&#10;Advertising or self-promotion&#10;Crossposting&#10;Off-topic&#10;Impersonation&#10;Sharing personal information&#10;Trolling or disruptive behavior"><%= settings.custom_warn_reasons ? (() => { try { return JSON.parse(settings.custom_warn_reasons).join('\n'); } catch { return ''; } })() : '' %></textarea>
            <a href="#" class="small mt-1 d-inline-block reset-default" data-target="custom_warn_reasons">Reset to defaults</a>
          </div>
        </div>
      </div>

      <!-- Custom Messages Section -->
      <div class="settings-section" id="section-messages">
        <div class="section-header">
          <i class="bi bi-chat-quote"></i>
          <h5>Custom Messages</h5>
          <button type="button" class="info-btn ms-auto"
                  data-bs-toggle="popover" data-bs-trigger="focus" data-bs-html="true" data-bs-placement="right"
                  data-bs-title="Variables & Formatting"
                  data-bs-content="<strong>Variables</strong><br><code>{user}</code> &mdash; user mention<br><code>{count}</code> &mdash; warning count<br><br><strong>Formatting</strong><br><code>**bold**</code><br><code>*italic*</code><br><code>__underline__</code><br><code>~~strikethrough~~</code><br><code>&lt;#channel_id&gt;</code> &mdash; channel link">
            <i class="bi bi-info"></i>
          </button>
        </div>
        <div class="section-body">
          <span class="setting-hint mb-3 d-block">Customize the messages the bot sends. Leave blank to use the default.</span>
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="setting-label mb-0">First Crosspost Message</label>
                  <span class="var-badge">{user}</span>
                </div>
                <span class="setting-hint">Sent when a user crossposts for the first time.</span>
                <textarea name="crosspost_first_message" class="form-control" rows="3"
                          placeholder="{user}, please do not crosspost the same message across multiple channels. Use the channel that best fits your topic. Duplicate messages have been removed."><%= settings.crosspost_first_message || '' %></textarea>
                <a href="#" class="small mt-1 d-inline-block reset-default" data-target="crosspost_first_message">Reset to default</a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="setting-label mb-0">Repeat Crosspost Message</label>
                  <div class="d-flex gap-1">
                    <span class="var-badge">{user}</span>
                    <span class="var-badge">{count}</span>
                  </div>
                </div>
                <span class="setting-hint">Sent on repeat offenses with an auto-warning.</span>
                <textarea name="crosspost_repeat_message" class="form-control" rows="3"
                          placeholder="{user}, you have repeatedly crossposted the same message across multiple channels. This is an official warning (warning #{count}). Continued violations may result in a ban.
Please review the channel list and post in the most appropriate channel moving forward."><%= settings.crosspost_repeat_message || '' %></textarea>
                <a href="#" class="small mt-1 d-inline-block reset-default" data-target="crosspost_repeat_message">Reset to default</a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="setting-label mb-0">Public Warning Message</label>
                  <span class="var-badge">{user}</span>
                </div>
                <span class="setting-hint">Sent publicly when a moderator issues a /warn.</span>
                <textarea name="warn_public_message" class="form-control" rows="3"
                          placeholder="{user}, you have received an official warning."><%= settings.warn_public_message || '' %></textarea>
                <a href="#" class="small mt-1 d-inline-block reset-default" data-target="warn_public_message">Reset to default</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bot Section -->
      <div class="settings-section" id="section-bot">
        <div class="section-header">
          <i class="bi bi-robot"></i>
          <h5>Bot</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-chat-dots"></i> Status Message</label>
                <span class="setting-hint">The bot's custom status shown under its name in Discord. Leave blank to clear. Updates instantly.</span>
                <input type="text" name="bot_status_message" class="form-control"
                       placeholder="DM for help!" maxlength="128"
                       value="<%= settings.bot_status_message || '' %>">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Save Button -->
      <div class="save-bar">
        <button type="submit" class="btn btn-save-settings">
          <i class="bi bi-check-lg"></i> Save Settings
        </button>
      </div>

    </div>
  </div>
</form>

<script>
// Word filter: load words on page load
(function() {
  const guildId = '<%= guild.id %>';

  async function loadFilterWords() {
    const container = document.getElementById('filter-words-container');
    const loading = document.getElementById('filter-words-loading');
    try {
      const res = await fetch(`/api/guild/${guildId}/filter-words`);
      const result = await res.json();
      if (loading) loading.remove();

      const words = result.words || [];
      if (words.length === 0) {
        container.innerHTML = '<p style="color: var(--text-muted); font-size: 0.88rem;">No filtered words configured.</p>';
        return;
      }

      // Group by tier
      const groups = { hard: [], soft: [], auto_delete: [] };
      words.forEach(w => {
        const tier = w.tier || 'hard';
        if (!groups[tier]) groups[tier] = [];
        groups[tier].push(w);
      });

      let html = '';
      const tierLabels = { hard: 'Hard Filter', soft: 'Soft Filter', auto_delete: 'Auto Delete' };
      for (const [tier, items] of Object.entries(groups)) {
        if (items.length === 0) continue;
        html += `<div class="filter-word-group">`;
        html += `<div class="filter-word-group-label">${tierLabels[tier] || tier} (${items.length})</div>`;
        html += `<div class="filter-words-container">`;
        items.forEach(w => {
          html += `<div class="filter-word-item">
            <span class="tier-badge-${tier}">${tier}</span>
            <span class="filter-word-spoiler" onclick="this.classList.toggle('revealed')">${escapeHtml(w.word)}</span>
            <button type="button" class="filter-word-delete" onclick="removeFilterWord('${guildId}', ${w.id}, this)" title="Remove">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>`;
        });
        html += `</div></div>`;
      }
      container.innerHTML = html;
    } catch (err) {
      if (loading) loading.remove();
      container.innerHTML = '<p style="color: var(--accent-red); font-size: 0.88rem;">Failed to load filtered words.</p>';
    }
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  window.addFilterWord = async function(guildId) {
    const input = document.getElementById('filter-word-input');
    const tierSelect = document.getElementById('filter-word-tier');
    const word = input.value.trim();
    if (!word) return;

    try {
      const res = await fetch(`/api/guild/${guildId}/filter-words`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ word, tier: tierSelect.value }),
      });
      const result = await res.json();
      if (result.success) {
        input.value = '';
        showToast('Word added to filter.');
        loadFilterWords();
      } else {
        showToast(result.error || 'Failed to add word', 'error');
      }
    } catch (err) {
      showToast('Failed: ' + err.message, 'error');
    }
  };

  window.removeFilterWord = async function(guildId, wordId, btn) {
    try {
      const res = await fetch(`/api/guild/${guildId}/filter-words/${wordId}`, {
        method: 'DELETE',
      });
      const result = await res.json();
      if (result.success) {
        const item = btn.closest('.filter-word-item');
        if (item) {
          item.style.transition = 'opacity 0.2s ease';
          item.style.opacity = '0';
          setTimeout(() => {
            item.remove();
            loadFilterWords();
          }, 200);
        }
        showToast('Word removed from filter.');
      } else {
        showToast(result.error || 'Failed', 'error');
      }
    } catch (err) {
      showToast('Failed: ' + err.message, 'error');
    }
  };

  loadFilterWords();
})();
</script>

<%- footer %>
