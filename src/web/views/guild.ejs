<%- header %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/dashboard">Servers</a></li>
    <li class="breadcrumb-item active"><%= guild.name %></li>
  </ol>
</nav>

<div class="guild-page-header">
  <div class="guild-title">
    <% if (guild.icon) { %>
      <img src="<%= guild.icon %>?size=80" class="guild-icon-sm" alt="icon">
    <% } %>
    <h2><%= guild.name %></h2>
  </div>
  <a href="/dashboard/guild/<%= guild.id %>/warnings" class="btn btn-outline-warning">
    <i class="bi bi-exclamation-triangle"></i> View Warnings
  </a>
</div>

<div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3"></div>

<form id="settings-form" data-guild-id="<%= guild.id %>">
  <div class="guild-settings-layout">

    <!-- Sidebar Navigation -->
    <div class="settings-sidebar">
      <a class="sidebar-nav-item active" href="#section-roles" data-section="section-roles">
        <i class="bi bi-shield"></i> Roles
      </a>
      <a class="sidebar-nav-item" href="#section-channels" data-section="section-channels">
        <i class="bi bi-hash"></i> Channels
      </a>
      <a class="sidebar-nav-item" href="#section-crosspost" data-section="section-crosspost">
        <i class="bi bi-layers"></i> Crosspost Detection
      </a>
      <a class="sidebar-nav-item" href="#section-warnings" data-section="section-warnings">
        <i class="bi bi-exclamation-octagon"></i> Warning System
      </a>
      <a class="sidebar-nav-item" href="#section-exempt" data-section="section-exempt">
        <i class="bi bi-slash-circle"></i> Exempt Channels
      </a>
      <a class="sidebar-nav-item" href="#section-messages" data-section="section-messages">
        <i class="bi bi-chat-quote"></i> Custom Messages
      </a>
    </div>

    <!-- Settings Content -->
    <div class="settings-content">

      <!-- Roles Section -->
      <div class="settings-section" id="section-roles">
        <div class="section-header">
          <i class="bi bi-shield"></i>
          <h5>Roles</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label">Moderator Role</label>
                <span class="setting-hint">This role and all roles above it are exempt from crosspost detection.</span>
                <select name="moderator_role_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= settings.moderator_role_id === role.id ? 'selected' : '' %>>
                      <%= role.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label">Warn Role (Trial Mod)</label>
                <span class="setting-hint">Members with this role can issue warnings but cannot ban.</span>
                <select name="warn_role_id" class="form-select">
                  <option value="">-- Not set --</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>" <%= settings.warn_role_id === role.id ? 'selected' : '' %>>
                      <%= role.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Channels Section -->
      <div class="settings-section" id="section-channels">
        <div class="section-header">
          <i class="bi bi-hash"></i>
          <h5>Log Channels</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-journal-text"></i> Warn Log Channel</label>
                <span class="setting-hint">Channel where warning details are posted. Set to "Disabled" to turn off.</span>
                <select name="warn_log_channel_id" class="form-select">
                  <option value="">-- Disabled --</option>
                  <% channels.forEach(ch => { %>
                    <option value="<%= ch.id %>" <%= settings.warn_log_channel_id === ch.id ? 'selected' : '' %>>
                      #<%= ch.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-hammer"></i> Ban Log Channel</label>
                <span class="setting-hint">Channel where bans triggered by the warning system are logged.</span>
                <select name="ban_log_channel_id" class="form-select">
                  <option value="">-- Disabled --</option>
                  <% channels.forEach(ch => { %>
                    <option value="<%= ch.id %>" <%= settings.ban_log_channel_id === ch.id ? 'selected' : '' %>>
                      #<%= ch.name %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Crosspost Detection Section -->
      <div class="settings-section" id="section-crosspost">
        <div class="section-header">
          <i class="bi bi-layers"></i>
          <h5>Crosspost Detection</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-sliders"></i> Similarity Threshold</label>
                <span class="setting-hint">How similar messages must be to trigger detection (1-100%).</span>
                <div class="d-flex align-items-center gap-3">
                  <input type="range" name="crosspost_threshold" class="form-range flex-grow-1"
                         min="1" max="100" value="<%= settings.crosspost_threshold %>"
                         oninput="this.nextElementSibling.textContent = this.value + '%'">
                  <span class="badge bg-primary fs-6" style="min-width: 52px; text-align: center;"><%= settings.crosspost_threshold %>%</span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-clock"></i> Detection Window</label>
                <span class="setting-hint">How quickly a similar message in another channel triggers detection.</span>
                <div class="input-group">
                  <input type="number" name="crosspost_detection_seconds" class="form-control"
                         min="5" max="3600" value="<%= settings.crosspost_detection_seconds %>">
                  <span class="input-group-text">seconds</span>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label"><i class="bi bi-arrow-repeat"></i> Repeat Offense Window</label>
                <span class="setting-hint">If a user crossposts again within this period, it escalates to a warning.</span>
                <div class="input-group">
                  <input type="number" name="crosspost_window_hours" class="form-control"
                         min="1" max="168" value="<%= settings.crosspost_window_hours %>">
                  <span class="input-group-text">hours</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Warning System Section -->
      <div class="settings-section" id="section-warnings">
        <div class="section-header">
          <i class="bi bi-exclamation-octagon"></i>
          <h5>Warning System</h5>
        </div>
        <div class="section-body">
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <label class="setting-label">Warning Threshold</label>
                <span class="setting-hint">Number of warnings before moderators are prompted to ban.</span>
                <div class="input-group">
                  <input type="number" name="warning_threshold" class="form-control"
                         min="1" max="50" value="<%= settings.warning_threshold %>">
                  <span class="input-group-text">warnings</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Exempt Channels Section -->
      <div class="settings-section" id="section-exempt">
        <div class="section-header">
          <i class="bi bi-slash-circle"></i>
          <h5>Exempt Channels</h5>
        </div>
        <div class="section-body">
          <div class="setting-item">
            <span class="setting-hint">Messages in these channels are not checked for crossposts.</span>
            <div class="d-flex flex-wrap gap-2 mb-3" id="exempt-channels-list">
              <% exemptChannels.forEach(chId => { %>
                <% const ch = channels.find(c => c.id === chId); %>
                <span class="badge bg-secondary d-flex align-items-center gap-1 py-1 exempt-badge" data-channel-id="<%= chId %>">
  #<%= ch ? ch.name : chId %>
  <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.5rem; width: 0.5em; height: 0.5em;"
          onclick="removeExemptChannel('<%= guild.id %>', '<%= chId %>', this)"></button>
</span>
              <% }); %>
            </div>
            <div class="input-group">
              <select id="add-exempt-channel" class="form-select">
                <option value="">-- Select channel --</option>
                <% channels.forEach(ch => { %>
                  <% if (!exemptChannels.includes(ch.id)) { %>
                    <option value="<%= ch.id %>">#<%= ch.name %></option>
                  <% } %>
                <% }); %>
              </select>
              <button type="button" class="btn btn-outline-primary"
                      onclick="addExemptChannel('<%= guild.id %>')">
                <i class="bi bi-plus-lg"></i> Add
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Custom Messages Section -->
      <div class="settings-section" id="section-messages">
        <div class="section-header">
          <i class="bi bi-chat-quote"></i>
          <h5>Custom Messages</h5>
          <button type="button" class="info-btn ms-auto"
                  data-bs-toggle="popover" data-bs-trigger="focus" data-bs-html="true" data-bs-placement="right"
                  data-bs-title="Variables & Formatting"
                  data-bs-content="<strong>Variables</strong><br><code>{user}</code> &mdash; user mention<br><code>{count}</code> &mdash; warning count<br><br><strong>Formatting</strong><br><code>**bold**</code><br><code>*italic*</code><br><code>__underline__</code><br><code>~~strikethrough~~</code><br><code>&lt;#channel_id&gt;</code> &mdash; channel link">
            <i class="bi bi-info"></i>
          </button>
        </div>
        <div class="section-body">
          <span class="setting-hint mb-3 d-block">Customize the messages the bot sends. Leave blank to use the default.</span>
          <div class="row">
            <div class="col-md-6">
              <div class="setting-item">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="setting-label mb-0">First Crosspost Message</label>
                  <span class="var-badge">{user}</span>
                </div>
                <span class="setting-hint">Sent when a user crossposts for the first time.</span>
                <textarea name="crosspost_first_message" class="form-control" rows="3"
                          placeholder="{user}, please do not crosspost the same message across multiple channels. Use the channel that best fits your topic. Duplicate messages have been removed."><%= settings.crosspost_first_message || '' %></textarea>
                <a href="#" class="small mt-1 d-inline-block reset-default" data-target="crosspost_first_message">Reset to default</a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="setting-label mb-0">Repeat Crosspost Message</label>
                  <div class="d-flex gap-1">
                    <span class="var-badge">{user}</span>
                    <span class="var-badge">{count}</span>
                  </div>
                </div>
                <span class="setting-hint">Sent on repeat offenses with an auto-warning.</span>
                <textarea name="crosspost_repeat_message" class="form-control" rows="3"
                          placeholder="{user}, you have repeatedly crossposted the same message across multiple channels. This is an official warning (warning #{count}). Continued violations may result in a ban.
Please review the channel list and post in the most appropriate channel moving forward."><%= settings.crosspost_repeat_message || '' %></textarea>
                <a href="#" class="small mt-1 d-inline-block reset-default" data-target="crosspost_repeat_message">Reset to default</a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="setting-item">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="setting-label mb-0">Public Warning Message</label>
                  <span class="var-badge">{user}</span>
                </div>
                <span class="setting-hint">Sent publicly when a moderator issues a /warn.</span>
                <textarea name="warn_public_message" class="form-control" rows="3"
                          placeholder="{user}, you have received an official warning."><%= settings.warn_public_message || '' %></textarea>
                <a href="#" class="small mt-1 d-inline-block reset-default" data-target="warn_public_message">Reset to default</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Save Button -->
      <div class="save-bar">
        <button type="submit" class="btn btn-save-settings">
          <i class="bi bi-check-lg"></i> Save Settings
        </button>
      </div>

    </div>
  </div>
</form>

<%- footer %>
