<%- header %>

<div class="dashboard-header">
  <h2><i class="bi bi-grid-fill"></i> Your Servers</h2>
  <p>Select a server to manage its settings and view warnings.</p>
</div>

<% if (guilds.length === 0) { %>
  <div class="empty-state">
    <i class="bi bi-inbox"></i>
    <h5>No servers found</h5>
    <p>Make sure the bot is added to a server where you have <strong>Manage Server</strong> permission.</p>
  </div>
<% } else { %>
  <div class="row g-3">
    <% guilds.forEach((guild, i) => { %>
      <div class="col-6 col-md-4 col-lg-3">
        <a href="/dashboard/guild/<%= guild.id %>" class="text-decoration-none">
          <div class="guild-card h-100 animate-in" style="opacity: 0;">
            <div class="card-body text-center">
              <% if (guild.icon) { %>
                <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128"
                     class="guild-icon-img mb-2" width="64" height="64" alt="icon">
              <% } else { %>
                <div class="guild-icon-placeholder mb-2">
                  <%= guild.name.split(' ').map(w => w[0]).join('').slice(0, 2) %>
                </div>
              <% } %>
              <h6 class="text-light mb-1"><%= guild.name %></h6>
              <div class="member-count">
                <i class="bi bi-circle-fill"></i>
                <%= guild.memberCount %> members
              </div>
            </div>
          </div>
        </a>
      </div>
    <% }); %>
  </div>
<% } %>

<%- footer %>
