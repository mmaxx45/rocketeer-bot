<%- header %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/dashboard">Servers</a></li>
    <li class="breadcrumb-item"><a href="/dashboard/guild/<%= guild.id %>"><%= guild.name %></a></li>
    <li class="breadcrumb-item active">Statistics</li>
  </ol>
</nav>

<div class="guild-page-header mb-4">
  <div class="guild-title">
    <% if (guild.icon) { %>
      <img src="<%= guild.icon %>?size=80" class="guild-icon-sm" alt="icon">
    <% } %>
    <div>
      <h2><%= guild.name %></h2>
      <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Server Statistics</p>
    </div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a href="/dashboard/guild/<%= guild.id %>/licenses" class="btn btn-outline-success">
      <i class="bi bi-key"></i> License Stats
    </a>
    <a href="/dashboard/guild/<%= guild.id %>/warnings" class="btn btn-outline-warning">
      <i class="bi bi-exclamation-triangle"></i> View Warnings
    </a>
    <a href="/dashboard/guild/<%= guild.id %>" class="btn btn-outline-primary">
      <i class="bi bi-gear"></i> Settings
    </a>
  </div>
</div>

<!-- Overview Cards -->
<div class="warnings-stats mb-4">
  <div class="stat-card stat-card-clickable" onclick="showDetail('warnings')">
    <div class="stat-value"><%= stats.totalWarnings %></div>
    <div class="stat-label">Total Warnings</div>
  </div>
  <div class="stat-card stat-card-clickable" onclick="showDetail('bans')">
    <div class="stat-value"><%= stats.totalBans %></div>
    <div class="stat-label">Total Bans</div>
  </div>
  <div class="stat-card stat-card-clickable" onclick="showDetail('crosspost')">
    <div class="stat-value"><%= stats.totalCrosspostIncidents %></div>
    <div class="stat-label">Crosspost Incidents</div>
  </div>
  <div class="stat-card stat-card-clickable" onclick="showDetail('mods')">
    <div class="stat-value"><%= stats.activeMods %></div>
    <div class="stat-label">Active Moderators</div>
  </div>
</div>

<!-- Warnings Over Time -->
<div class="settings-section mb-4">
  <div class="section-header">
    <i class="bi bi-graph-up"></i>
    <h5>Warnings Over Time</h5>
    <div class="ms-auto d-flex gap-1">
      <button class="btn btn-sm btn-outline-secondary chart-range-btn" data-range="7d">7D</button>
      <button class="btn btn-sm btn-outline-secondary chart-range-btn" data-range="30d">30D</button>
      <button class="btn btn-sm btn-outline-secondary chart-range-btn active" data-range="8w">8W</button>
      <button class="btn btn-sm btn-outline-secondary chart-range-btn" data-range="6m">6M</button>
      <button class="btn btn-sm btn-outline-secondary chart-range-btn" data-range="1y">1Y</button>
    </div>
  </div>
  <div class="section-body">
    <div id="warnings-chart-empty" class="stats-empty-mini" style="display: none;">
      <i class="bi bi-graph-up"></i>
      <p>No warning data for this period.</p>
    </div>
    <div style="position: relative; height: 280px;">
      <canvas id="warnings-chart"></canvas>
    </div>
  </div>
</div>

<div class="row">
  <!-- Most Warned Users -->
  <div class="col-lg-6 mb-4">
    <div class="settings-section h-100">
      <div class="section-header">
        <i class="bi bi-person-exclamation"></i>
        <h5>Most Warned Users</h5>
      </div>
      <div class="section-body">
        <% if (stats.mostWarnedUsers.length === 0) { %>
          <div class="stats-empty-mini">
            <i class="bi bi-person-check"></i>
            <p>No warnings recorded yet.</p>
          </div>
        <% } else { %>
          <% const maxUserWarnings = stats.mostWarnedUsers[0].count; %>
          <div class="stats-ranked-list">
            <% stats.mostWarnedUsers.forEach((user, i) => { %>
              <div class="ranked-item">
                <span class="ranked-position"><%= i + 1 %></span>
                <% if (userMap[user.user_id]) { %>
                  <span class="user-display" title="Click to copy ID" onclick="copyId(this, '<%= user.user_id %>')">@<%= userMap[user.user_id] %></span>
                <% } else { %>
                  <span class="user-id-cell user-id-copy" title="Click to copy ID" onclick="copyId(this, '<%= user.user_id %>')"><%= user.user_id %></span>
                <% } %>
                <div class="ranked-bar-track">
                  <div class="bar-chart-fill bar-fill-yellow" style="width: <%= (user.count / maxUserWarnings) * 100 %>%"></div>
                </div>
                <span class="ranked-count"><%= user.count %></span>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Most Active Moderators -->
  <div class="col-lg-6 mb-4">
    <div class="settings-section h-100">
      <div class="section-header">
        <i class="bi bi-shield-check"></i>
        <h5>Most Active Moderators</h5>
      </div>
      <div class="section-body">
        <% if (stats.mostActiveMods.length === 0) { %>
          <div class="stats-empty-mini">
            <i class="bi bi-shield"></i>
            <p>No moderator actions recorded yet.</p>
          </div>
        <% } else { %>
          <% const maxModActions = stats.mostActiveMods[0].count; %>
          <div class="stats-ranked-list">
            <% stats.mostActiveMods.forEach((mod, i) => { %>
              <div class="ranked-item">
                <span class="ranked-position"><%= i + 1 %></span>
                <% if (mod.moderator_id === botId) { %>
                  <span class="user-display" style="color: #5865f2; font-weight: 600;"><i class="bi bi-robot"></i> Rocketeer</span>
                <% } else if (userMap[mod.moderator_id]) { %>
                  <span class="user-display" title="Click to copy ID" onclick="copyId(this, '<%= mod.moderator_id %>')">@<%= userMap[mod.moderator_id] %></span>
                <% } else { %>
                  <span class="user-id-cell user-id-copy" title="Click to copy ID" onclick="copyId(this, '<%= mod.moderator_id %>')"><%= mod.moderator_id %></span>
                <% } %>
                <div class="ranked-bar-track">
                  <div class="bar-chart-fill bar-fill-green" style="width: <%= (mod.count / maxModActions) * 100 %>%"></div>
                </div>
                <span class="ranked-count"><%= mod.count %></span>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Warning Reasons Breakdown -->
<div class="settings-section mb-4">
  <div class="section-header">
    <i class="bi bi-tags"></i>
    <h5>Warning Reasons Breakdown</h5>
  </div>
  <div class="section-body">
    <% if (stats.warningReasons.length === 0) { %>
      <div class="stats-empty-mini">
        <i class="bi bi-tags"></i>
        <p>No warning reasons to display.</p>
      </div>
    <% } else { %>
      <% const maxReasonCount = Math.max(...stats.warningReasons.map(r => r.count), 1); %>
      <div class="stats-bar-chart">
        <% stats.warningReasons.forEach(reason => { %>
          <div class="bar-chart-row">
            <div class="bar-chart-label bar-chart-label-wide" title="<%= reason.reason %>"><%= reason.reason %></div>
            <div class="bar-chart-track">
              <div class="bar-chart-fill bar-fill-cyan" style="width: <%= (reason.count / maxReasonCount) * 100 %>%"></div>
            </div>
            <div class="bar-chart-value"><%= reason.count %></div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<!-- Recent Activity -->
<div class="settings-section mb-4">
  <div class="section-header">
    <i class="bi bi-clock-history"></i>
    <h5>Recent Activity</h5>
  </div>
  <div class="section-body p-0">
    <% if (stats.recentActivity.length === 0) { %>
      <div class="stats-empty-mini" style="padding: 2rem;">
        <i class="bi bi-clock-history"></i>
        <p>No recent activity.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-dark table-striped table-hover mb-0">
          <thead>
            <tr>
              <th>Action</th>
              <th>Moderator</th>
              <th>Target</th>
              <th>Details</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% stats.recentActivity.forEach(action => { %>
              <tr>
                <td>
                  <% if (action.action_type === 'ban') { %>
                    <span class="stats-action-badge stats-action-ban">
                      <i class="bi bi-hammer"></i> Ban
                    </span>
                  <% } else if (action.action_type === 'kick') { %>
                    <span class="stats-action-badge stats-action-kick">
                      <i class="bi bi-door-open"></i> Kick
                    </span>
                  <% } else if (action.action_type === 'warn') { %>
                    <span class="stats-action-badge stats-action-warn">
                      <i class="bi bi-exclamation-triangle"></i> Warn
                    </span>
                  <% } else { %>
                    <span class="stats-action-badge stats-action-other">
                      <i class="bi bi-activity"></i> <%= action.action_type %>
                    </span>
                  <% } %>
                </td>
                <td><% if (action.moderator_id === botId) { %><span class="user-display" style="color: #5865f2;"><i class="bi bi-robot"></i> Rocketeer</span><% } else if (userMap[action.moderator_id]) { %><span class="user-display" title="Click to copy ID" onclick="copyId(this, '<%= action.moderator_id %>')">@<%= userMap[action.moderator_id] %></span><% } else { %><span class="user-id-cell user-id-copy" title="Click to copy ID" onclick="copyId(this, '<%= action.moderator_id %>')"><%= action.moderator_id %></span><% } %></td>
                <td><% if (userMap[action.target_id]) { %><span class="user-display" title="Click to copy ID" onclick="copyId(this, '<%= action.target_id %>')">@<%= userMap[action.target_id] %></span><% } else { %><span class="user-id-cell user-id-copy" title="Click to copy ID" onclick="copyId(this, '<%= action.target_id %>')"><%= action.target_id %></span><% } %></td>
                <td style="max-width: 250px;">
                  <% if (action.details) { %>
                    <span class="text-muted" title="<%= action.details %>"><%= action.details.length > 60 ? action.details.slice(0, 60) + '...' : action.details %></span>
                  <% } else { %>
                    <span style="color: var(--text-muted);">--</span>
                  <% } %>
                </td>
                <td style="white-space: nowrap; color: var(--text-secondary); font-size: 0.85rem;">
                  <%= new Date(action.created_at + 'Z').toLocaleString() %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
(function () {
  const guildId = '<%= guild.id %>';
  const canvas = document.getElementById('warnings-chart');
  const emptyMsg = document.getElementById('warnings-chart-empty');
  if (!canvas) return;

  let chart = null;

  async function loadChart(range) {
    try {
      const res = await fetch(`/api/guild/${guildId}/warnings-over-time?range=${range}`);
      const json = await res.json();
      const data = json.data || [];

      const allZero = data.every(d => d.count === 0);
      emptyMsg.style.display = allZero ? '' : 'none';
      canvas.style.display = allZero ? 'none' : '';

      if (chart) chart.destroy();

      chart = new Chart(canvas, {
        type: 'line',
        data: {
          labels: data.map(d => d.label),
          datasets: [{
            label: 'Warnings',
            data: data.map(d => d.count),
            borderColor: '#5865f2',
            backgroundColor: 'rgba(88, 101, 242, 0.15)',
            fill: true,
            tension: 0.3,
            pointBackgroundColor: '#5865f2',
            pointBorderColor: '#5865f2',
            pointRadius: 4,
            pointHoverRadius: 6,
            borderWidth: 2.5,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { intersect: false, mode: 'index' },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(30, 31, 34, 0.95)',
              titleColor: '#fff',
              bodyColor: '#b5bac1',
              borderColor: '#5865f2',
              borderWidth: 1,
              padding: 10,
              displayColors: false,
              callbacks: {
                label: function (ctx) {
                  const v = ctx.parsed.y;
                  return v === 1 ? '1 warning' : v + ' warnings';
                },
              },
            },
          },
          scales: {
            x: {
              grid: { color: 'rgba(255,255,255,0.06)' },
              ticks: { color: '#8b8d91', font: { size: 11 } },
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(255,255,255,0.06)' },
              ticks: {
                color: '#8b8d91',
                font: { size: 11 },
                precision: 0,
              },
            },
          },
        },
      });
    } catch (err) {
      console.error('Failed to load chart:', err);
    }
  }

  // Range button handling
  document.querySelectorAll('.chart-range-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.chart-range-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      loadChart(btn.dataset.range);
    });
  });

  // Initial load
  loadChart('8w');
})();
</script>

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content detail-modal-content">
      <div class="modal-header detail-modal-header">
        <h5 class="modal-title" id="detailModalTitle">Details</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body detail-modal-body" id="detailModalBody">
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const guildId = '<%= guild.id %>';
  const userMap = <%- JSON.stringify(userMap) %>;
  const botId = '<%= botId %>';
  let detailModal = null;

  function getModal() {
    if (!detailModal) {
      detailModal = new bootstrap.Modal(document.getElementById('detailModal'));
    }
    return detailModal;
  }

  function resolveUser(id) {
    if (id === botId) return '<i class="bi bi-robot"></i> Rocketeer';
    if (userMap[id]) return '@' + escapeHtml(userMap[id]);
    return '<span class="text-muted">' + escapeHtml(id) + '</span>';
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function formatDate(dateStr) {
    if (!dateStr) return '--';
    const d = new Date(dateStr + (dateStr.endsWith('Z') ? '' : 'Z'));
    return d.toLocaleString();
  }

  function setModalContent(title, html) {
    document.getElementById('detailModalTitle').textContent = title;
    document.getElementById('detailModalBody').innerHTML = html;
  }

  function setModalLoading(title) {
    document.getElementById('detailModalTitle').textContent = title;
    document.getElementById('detailModalBody').innerHTML =
      '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';
  }

  window.showDetail = async function (type) {
    const modal = getModal();
    const titles = {
      warnings: 'Warnings Breakdown',
      bans: 'Ban History',
      crosspost: 'Crosspost Incidents',
      mods: 'Active Moderators (Last 30 Days)',
    };
    setModalLoading(titles[type] || 'Details');
    modal.show();

    try {
      const endpoints = {
        warnings: `/api/guild/${guildId}/stats/warnings-detail`,
        bans: `/api/guild/${guildId}/stats/bans`,
        crosspost: `/api/guild/${guildId}/stats/crosspost-detail`,
        mods: `/api/guild/${guildId}/stats/mods-detail`,
      };
      const res = await fetch(endpoints[type]);
      if (!res.ok) throw new Error('Failed to fetch');
      const data = await res.json();

      let html = '';
      if (type === 'warnings') html = renderWarningsDetail(data);
      else if (type === 'bans') html = renderBansDetail(data);
      else if (type === 'crosspost') html = renderCrosspostDetail(data);
      else if (type === 'mods') html = renderModsDetail(data);

      setModalContent(titles[type], html);
    } catch (err) {
      setModalContent('Error', '<div class="text-center text-danger py-3"><i class="bi bi-exclamation-triangle"></i> Failed to load details.</div>');
    }
  };

  function renderWarningsDetail(data) {
    let html = '';

    // By type breakdown
    if (data.byType.length > 0) {
      html += '<h6 class="detail-section-title"><i class="bi bi-pie-chart"></i> By Type</h6>';
      html += '<div class="detail-badge-row">';
      data.byType.forEach(t => {
        const label = t.type === 'manual' ? 'Manual' : t.type === 'crosspost' ? 'Crosspost' : t.type;
        const cls = t.type === 'manual' ? 'detail-badge-yellow' : 'detail-badge-cyan';
        html += '<span class="detail-badge ' + cls + '">' + escapeHtml(label) + ': ' + t.count + '</span>';
      });
      html += '</div>';
    }

    // By month
    if (data.byMonth.length > 0) {
      html += '<h6 class="detail-section-title"><i class="bi bi-calendar3"></i> By Month</h6>';
      html += '<div class="detail-bar-list">';
      const maxCount = Math.max(...data.byMonth.map(m => m.count), 1);
      data.byMonth.forEach(m => {
        const pct = (m.count / maxCount) * 100;
        html += '<div class="detail-bar-row">';
        html += '<span class="detail-bar-label">' + escapeHtml(m.month) + '</span>';
        html += '<div class="detail-bar-track"><div class="detail-bar-fill detail-fill-yellow" style="width:' + pct + '%"></div></div>';
        html += '<span class="detail-bar-value">' + m.count + '</span>';
        html += '</div>';
      });
      html += '</div>';
    }

    // Recent warnings
    if (data.recent.length > 0) {
      html += '<h6 class="detail-section-title"><i class="bi bi-clock-history"></i> Recent Warnings</h6>';
      html += '<div class="table-responsive"><table class="table table-dark table-striped table-hover mb-0 detail-table">';
      html += '<thead><tr><th>User</th><th>Moderator</th><th>Type</th><th>Reason</th><th>Date</th></tr></thead><tbody>';
      data.recent.forEach(w => {
        const typeBadge = w.type === 'manual'
          ? '<span class="detail-type-badge detail-type-manual">Manual</span>'
          : '<span class="detail-type-badge detail-type-crosspost">Crosspost</span>';
        html += '<tr>';
        html += '<td>' + resolveUser(w.user_id) + '</td>';
        html += '<td>' + resolveUser(w.moderator_id) + '</td>';
        html += '<td>' + typeBadge + '</td>';
        html += '<td class="detail-reason-cell" title="' + escapeHtml(w.reason || '') + '">' + escapeHtml((w.reason || '--').slice(0, 60)) + '</td>';
        html += '<td class="detail-date-cell">' + formatDate(w.created_at) + '</td>';
        html += '</tr>';
      });
      html += '</tbody></table></div>';
    }

    if (!html) html = '<div class="text-center text-muted py-3">No warning data available.</div>';
    return html;
  }

  function renderBansDetail(data) {
    if (!data.bans || data.bans.length === 0) {
      return '<div class="text-center text-muted py-3"><i class="bi bi-shield-check"></i> No bans recorded.</div>';
    }

    let html = '<div class="table-responsive"><table class="table table-dark table-striped table-hover mb-0 detail-table">';
    html += '<thead><tr><th>Target</th><th>Moderator</th><th>Details</th><th>Date</th></tr></thead><tbody>';
    data.bans.forEach(b => {
      html += '<tr>';
      html += '<td>' + resolveUser(b.target_id) + '</td>';
      html += '<td>' + resolveUser(b.moderator_id) + '</td>';
      html += '<td class="detail-reason-cell" title="' + escapeHtml(b.details || '') + '">' + escapeHtml((b.details || '--').slice(0, 60)) + '</td>';
      html += '<td class="detail-date-cell">' + formatDate(b.created_at) + '</td>';
      html += '</tr>';
    });
    html += '</tbody></table></div>';
    return html;
  }

  function renderCrosspostDetail(data) {
    let html = '';

    // By action breakdown
    if (data.byAction.length > 0) {
      html += '<h6 class="detail-section-title"><i class="bi bi-funnel"></i> By Action Taken</h6>';
      html += '<div class="detail-badge-row">';
      data.byAction.forEach(a => {
        const cls = a.action_taken === 'deleted' ? 'detail-badge-red' : 'detail-badge-yellow';
        html += '<span class="detail-badge ' + cls + '">' + escapeHtml(a.action_taken) + ': ' + a.count + '</span>';
      });
      html += '</div>';
    }

    // Top offenders
    if (data.topOffenders.length > 0) {
      html += '<h6 class="detail-section-title"><i class="bi bi-person-exclamation"></i> Top Offenders</h6>';
      html += '<div class="detail-bar-list">';
      const maxCount = Math.max(...data.topOffenders.map(o => o.count), 1);
      data.topOffenders.forEach((o, i) => {
        const pct = (o.count / maxCount) * 100;
        html += '<div class="detail-bar-row">';
        html += '<span class="detail-bar-rank">' + (i + 1) + '</span>';
        html += '<span class="detail-bar-label">' + resolveUser(o.user_id) + '</span>';
        html += '<div class="detail-bar-track"><div class="detail-bar-fill detail-fill-red" style="width:' + pct + '%"></div></div>';
        html += '<span class="detail-bar-value">' + o.count + '</span>';
        html += '</div>';
      });
      html += '</div>';
    }

    // Recent incidents
    if (data.recent.length > 0) {
      html += '<h6 class="detail-section-title"><i class="bi bi-clock-history"></i> Recent Incidents</h6>';
      html += '<div class="table-responsive"><table class="table table-dark table-striped table-hover mb-0 detail-table">';
      html += '<thead><tr><th>User</th><th>Action</th><th>Similarity</th><th>Date</th></tr></thead><tbody>';
      data.recent.forEach(r => {
        const actionBadge = r.action_taken === 'deleted'
          ? '<span class="detail-type-badge detail-type-deleted">Deleted</span>'
          : '<span class="detail-type-badge detail-type-warned">Warned</span>';
        html += '<tr>';
        html += '<td>' + resolveUser(r.user_id) + '</td>';
        html += '<td>' + actionBadge + '</td>';
        html += '<td>' + Math.round(r.similarity_score * 100) + '%</td>';
        html += '<td class="detail-date-cell">' + formatDate(r.created_at) + '</td>';
        html += '</tr>';
      });
      html += '</tbody></table></div>';
    }

    if (!html) html = '<div class="text-center text-muted py-3">No crosspost incident data available.</div>';
    return html;
  }

  function renderModsDetail(data) {
    if (!data.mods || data.mods.length === 0) {
      return '<div class="text-center text-muted py-3"><i class="bi bi-shield"></i> No moderator actions in the last 30 days.</div>';
    }

    // Group by moderator
    const modMap = {};
    data.mods.forEach(m => {
      if (!modMap[m.moderator_id]) modMap[m.moderator_id] = { total: 0, actions: {} };
      modMap[m.moderator_id].actions[m.action_type] = m.count;
      modMap[m.moderator_id].total += m.count;
    });

    // Sort by total actions descending
    const sorted = Object.entries(modMap).sort((a, b) => b[1].total - a[1].total);

    let html = '<div class="table-responsive"><table class="table table-dark table-striped table-hover mb-0 detail-table">';
    html += '<thead><tr><th>#</th><th>Moderator</th><th>Actions</th><th>Total</th></tr></thead><tbody>';
    sorted.forEach(([modId, info], i) => {
      const actionTags = Object.entries(info.actions).map(([type, count]) => {
        let cls = 'detail-type-other';
        if (type === 'ban') cls = 'detail-type-deleted';
        else if (type === 'warn') cls = 'detail-type-manual';
        else if (type === 'kick') cls = 'detail-type-crosspost';
        return '<span class="detail-type-badge ' + cls + '">' + escapeHtml(type) + ' ' + count + '</span>';
      }).join(' ');
      html += '<tr>';
      html += '<td>' + (i + 1) + '</td>';
      html += '<td>' + resolveUser(modId) + '</td>';
      html += '<td>' + actionTags + '</td>';
      html += '<td><strong>' + info.total + '</strong></td>';
      html += '</tr>';
    });
    html += '</tbody></table></div>';
    return html;
  }
})();
</script>

