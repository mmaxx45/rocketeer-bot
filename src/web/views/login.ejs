<%- header %>

<div class="login-page">
  <div class="login-card">
    <div class="login-logo">
      <i class="bi bi-rocket-takeoff"></i>
    </div>
    <h1>RocketeerBot</h1>
    <p class="lead mb-0">
      Crosspost detection, warning system, and moderation tools for your Discord server.
    </p>

    <div class="login-features">
      <div class="login-feature">
        <i class="bi bi-shield-check" style="color: var(--accent-blurple);"></i>
        <div>
          <h6>Crosspost Detection</h6>
          <p>Auto-detect and remove duplicate messages across channels.</p>
        </div>
      </div>
      <div class="login-feature">
        <i class="bi bi-exclamation-triangle" style="color: var(--accent-amber);"></i>
        <div>
          <h6>Warning System</h6>
          <p>Issue and track warnings with escalation to bans.</p>
        </div>
      </div>
      <div class="login-feature">
        <i class="bi bi-sliders" style="color: var(--accent-green);"></i>
        <div>
          <h6>Web Dashboard</h6>
          <p>Configure everything from a clean web interface.</p>
        </div>
      </div>
    </div>

    <a href="/auth/discord" class="btn btn-discord">
      <i class="bi bi-discord"></i> Login with Discord
    </a>
  </div>
</div>

<%- footer %>
