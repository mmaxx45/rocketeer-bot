<%- header %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/dashboard">Servers</a></li>
    <li class="breadcrumb-item"><a href="/dashboard/guild/<%= guild.id %>"><%= guild.name %></a></li>
    <li class="breadcrumb-item active">Warnings</li>
  </ol>
</nav>

<div class="guild-page-header mb-4">
  <div class="guild-title">
    <% if (guild.icon) { %>
      <img src="<%= guild.icon %>?size=80" class="guild-icon-sm" alt="icon">
    <% } %>
    <div>
      <h2><%= guild.name %></h2>
      <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Warning Management</p>
    </div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a href="/dashboard/guild/<%= guild.id %>/stats" class="btn btn-outline-info">
      <i class="bi bi-bar-chart-line"></i> Stats
    </a>
    <a href="/dashboard/guild/<%= guild.id %>" class="btn btn-outline-primary">
      <i class="bi bi-gear"></i> Back to Settings
    </a>
  </div>
</div>

<div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3"></div>

<!-- Stats -->
<div class="warnings-stats mb-4">
  <div class="stat-card">
    <div class="stat-value"><%= total %></div>
    <div class="stat-label">Total Warnings</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">
      <%= warnings.filter(w => w.type === 'crosspost').length %><% if (page === 1 && totalPages <= 1) { %><% } else { %>+<% } %>
    </div>
    <div class="stat-label">Crosspost</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">
      <%= warnings.filter(w => w.type === 'manual').length %><% if (page === 1 && totalPages <= 1) { %><% } else { %>+<% } %>
    </div>
    <div class="stat-label">Manual</div>
  </div>
</div>

<% if (warnings.length === 0) { %>
  <div class="warnings-empty">
    <i class="bi bi-check-circle"></i>
    <h5>All Clear</h5>
    <p>No warnings recorded for this server.</p>
  </div>
<% } else { %>
  <div class="warnings-table-wrapper">
    <div class="table-responsive">
      <table class="table table-dark table-striped table-hover">
        <thead>
          <tr>
            <th>ID</th>
            <th>User</th>
            <th>Reason</th>
            <th>Message</th>
            <th>Type</th>
            <th>Issued By</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% warnings.forEach(w => { %>
            <tr id="warning-row-<%= w.id %>">
              <td><span style="color: var(--text-muted);">#</span><%= w.id %></td>
              <td><% if (userMap[w.user_id]) { %><span class="user-display" title="Click to copy ID" onclick="copyId(this, '<%= w.user_id %>')">@<%= userMap[w.user_id] %></span><% } else { %><span class="user-id-cell user-id-copy" title="Click to copy ID" onclick="copyId(this, '<%= w.user_id %>')"><%= w.user_id %></span><% } %></td>
              <td style="max-width: 280px;"><%= w.reason %></td>
              <td style="max-width: 200px;">
                <% if (w.message_content) { %>
                  <span class="text-muted" title="<%= w.message_content %>"><%= w.message_content.length > 50 ? w.message_content.slice(0, 50) + '...' : w.message_content %></span>
                <% } else { %>
                  <span style="color: var(--text-muted);">--</span>
                <% } %>
              </td>
              <td>
                <span class="<%= w.type === 'crosspost' ? 'badge-crosspost' : 'badge-manual' %>">
                  <i class="bi <%= w.type === 'crosspost' ? 'bi-layers' : 'bi-person' %>"></i>
                  <%= w.type %>
                </span>
              </td>
              <td><% if (userMap[w.moderator_id]) { %><span class="user-display" title="Click to copy ID" onclick="copyId(this, '<%= w.moderator_id %>')">@<%= userMap[w.moderator_id] %></span><% } else { %><span class="user-id-cell user-id-copy" title="Click to copy ID" onclick="copyId(this, '<%= w.moderator_id %>')"><%= w.moderator_id %></span><% } %></td>
              <td style="white-space: nowrap; color: var(--text-secondary); font-size: 0.85rem;">
                <%= new Date(w.created_at + 'Z').toLocaleString() %>
              </td>
              <td>
                <button class="btn btn-outline-danger btn-sm"
                        onclick="deleteWarning('<%= guild.id %>', '<%= w.id %>')"
                        title="Delete warning">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (totalPages > 1) { %>
    <nav aria-label="Warnings pagination" class="mt-4">
      <ul class="pagination justify-content-center">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= page - 1 %>">
            <i class="bi bi-chevron-left"></i> Previous
          </a>
        </li>
        <% for (let p = 1; p <= totalPages; p++) { %>
          <li class="page-item <%= p === page ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= p %>"><%= p %></a>
          </li>
        <% } %>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= page + 1 %>">
            Next <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      </ul>
    </nav>
  <% } %>
<% } %>

<%- footer %>
