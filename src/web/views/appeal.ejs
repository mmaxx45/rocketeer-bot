<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    .appeal-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }
    .appeal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-default);
      border-radius: 16px;
      padding: 2.5rem;
      max-width: 520px;
      width: 100%;
    }
    .appeal-guild {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .appeal-guild img {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      border: 2px solid var(--border-default);
    }
    .appeal-guild-icon-fallback {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--bg-raised);
      border: 2px solid var(--border-default);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: var(--text-muted);
    }
    .appeal-guild h2 {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary);
    }
    .appeal-guild p {
      margin: 0;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }
    .appeal-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 0.4rem;
      display: block;
    }
    .appeal-hint {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.3rem;
    }
    .appeal-input {
      width: 100%;
      padding: 0.65rem 0.85rem;
      background: var(--bg-input);
      border: 1px solid var(--border-default);
      border-radius: 8px;
      color: var(--text-primary);
      font-size: 0.9rem;
      font-family: inherit;
      transition: border-color 0.2s;
    }
    .appeal-input:focus {
      outline: none;
      border-color: var(--accent-blurple);
      box-shadow: 0 0 0 3px var(--accent-blurple-glow);
    }
    .appeal-textarea {
      min-height: 120px;
      resize: vertical;
    }
    .appeal-field {
      margin-bottom: 1.25rem;
    }
    .appeal-btn {
      width: 100%;
      padding: 0.7rem;
      background: var(--accent-blurple);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      font-family: inherit;
    }
    .appeal-btn:hover {
      background: var(--accent-blurple-hover);
    }
    .appeal-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    .appeal-alert {
      padding: 0.85rem 1rem;
      border-radius: 8px;
      font-size: 0.85rem;
      margin-bottom: 1.25rem;
    }
    .appeal-alert-error {
      background: rgba(237,66,69,0.1);
      border: 1px solid rgba(237,66,69,0.25);
      color: #ed4245;
    }
    .appeal-alert-success {
      background: rgba(67,181,129,0.1);
      border: 1px solid rgba(67,181,129,0.25);
      color: var(--accent-green);
    }
    .appeal-back {
      display: inline-block;
      margin-top: 1.25rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      text-decoration: none;
    }
    .appeal-back:hover { color: var(--text-secondary); }
    .char-count { font-size: 0.75rem; color: var(--text-muted); text-align: right; margin-top: 0.2rem; }
  </style>
</head>
<body>
  <div class="appeal-page">
    <div class="appeal-card">
      <% if (!guild) { %>
        <div class="appeal-alert appeal-alert-error"><i class="bi bi-exclamation-circle"></i> <%= error %></div>
        <a href="/" class="appeal-back"><i class="bi bi-arrow-left"></i> Back</a>
      <% } else if (error) { %>
        <div class="appeal-guild">
          <% if (guild.icon) { %>
            <img src="<%= guild.icon %>" alt="">
          <% } else { %>
            <div class="appeal-guild-icon-fallback"><i class="bi bi-shield"></i></div>
          <% } %>
          <div>
            <h2><%= guild.name %></h2>
            <p>Ban Appeal</p>
          </div>
        </div>
        <div class="appeal-alert appeal-alert-error"><i class="bi bi-exclamation-circle"></i> <%= error %></div>
      <% } else { %>
        <div class="appeal-guild">
          <% if (guild.icon) { %>
            <img src="<%= guild.icon %>" alt="">
          <% } else { %>
            <div class="appeal-guild-icon-fallback"><i class="bi bi-shield"></i></div>
          <% } %>
          <div>
            <h2><%= guild.name %></h2>
            <p>Ban Appeal</p>
          </div>
        </div>

        <div id="appeal-message" style="display:none;"></div>

        <form id="appeal-form" onsubmit="return submitAppeal(event)">
          <div class="appeal-field">
            <label class="appeal-label">Your Discord User ID</label>
            <input type="text" class="appeal-input" id="user_id" name="user_id"
                   placeholder="e.g. 123456789012345678" required pattern="\d{17,20}" maxlength="20">
            <p class="appeal-hint">Enable Developer Mode in Discord Settings &gt; Advanced, then right-click your name and copy your ID.</p>
          </div>

          <div class="appeal-field">
            <label class="appeal-label">Why should your ban be lifted?</label>
            <textarea class="appeal-input appeal-textarea" id="reason" name="reason"
                      placeholder="Explain why you believe your ban should be reconsidered..."
                      required maxlength="1000" oninput="updateCharCount()"></textarea>
            <div class="char-count"><span id="char-current">0</span> / 1000</div>
          </div>

          <button type="submit" class="appeal-btn" id="submit-btn">
            <i class="bi bi-send"></i> Submit Appeal
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <script>
    function updateCharCount() {
      const reason = document.getElementById('reason');
      document.getElementById('char-current').textContent = reason.value.length;
    }

    async function submitAppeal(e) {
      e.preventDefault();
      const btn = document.getElementById('submit-btn');
      const msgDiv = document.getElementById('appeal-message');
      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Submitting...';
      msgDiv.style.display = 'none';

      const user_id = document.getElementById('user_id').value.trim();
      const reason = document.getElementById('reason').value.trim();

      try {
        const res = await fetch(`/appeal/<%= guild ? guild.id : '' %>/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id, reason }),
        });
        const data = await res.json();

        if (data.success) {
          msgDiv.className = 'appeal-alert appeal-alert-success';
          msgDiv.innerHTML = '<i class="bi bi-check-circle"></i> ' + data.message;
          msgDiv.style.display = 'block';
          document.getElementById('appeal-form').style.display = 'none';
        } else {
          msgDiv.className = 'appeal-alert appeal-alert-error';
          msgDiv.innerHTML = '<i class="bi bi-exclamation-circle"></i> ' + (data.error || 'Something went wrong.');
          msgDiv.style.display = 'block';
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-send"></i> Submit Appeal';
        }
      } catch {
        msgDiv.className = 'appeal-alert appeal-alert-error';
        msgDiv.innerHTML = '<i class="bi bi-exclamation-circle"></i> Network error. Please try again.';
        msgDiv.style.display = 'block';
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send"></i> Submit Appeal';
      }
      return false;
    }
  </script>
</body>
</html>
